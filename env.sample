# Copy to .env  ->  cp env.sample .env

# Slack — see STACK.md section 1 for the exact click path
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
AMEEN_CHANNEL=ap-review

# Model access, routed through OpenRouter
OPENROUTER_API_KEY=sk-or-...
AMEEN_MODEL=anthropic/claude-sonnet-4-6

# Google Sheets tracker (optional; the agent degrades to local-only if unset)
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
AMEEN_SHEET_ID=

# Approval thresholds, in the base currency
AMEEN_L1_MAX=1000
AMEEN_L2_MAX=10000
AMEEN_L3_MAX=50000

# Tolerance before a price difference counts as a mismatch
AMEEN_PRICE_TOLERANCE=0.02
